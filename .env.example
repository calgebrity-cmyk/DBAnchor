# ==============================================================================
# DBAnchor Environment Configuration
# ==============================================================================

# Primary Database Connection URL
# Standard PostgreSQL format:
# postgresql+psycopg://username:password@localhost:5432/dbname
# postgresql://username:password@localhost:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# Application Environment (development, test, staging, production)
APP_ENV=development

# Optional DBAnchor Configuration Overrides
# DBANCHOR_CONNECT_TIMEOUT=10
# DBANCHOR_POOL_SIZE=5
# DBANCHOR_MAX_OVERFLOW=10
# DBANCHOR_ALLOW_DESTRUCTIVE=false
